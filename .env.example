# WhatsApp Provider
# wati | twilio | respondio | 360dialog
WHATSAPP_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WEBHOOK_VERIFY_TOKEN=

# WATI (solo si WHATSAPP_PROVIDER=wati)
WHATSAPP_API_URL=
WHATSAPP_API_KEY=

# respond.io (solo si WHATSAPP_PROVIDER=respondio)
RESPOND_IO_API_TOKEN=
RESPOND_IO_WEBHOOK_SECRET=
RESPOND_IO_API_BASE_URL=https://api.respond.io

# 360dialog (solo si WHATSAPP_PROVIDER=360dialog)
D360_API_KEY=
D360_API_BASE_URL=https://waba-v2.360dialog.io
D360_WEBHOOK_SECRET=

# Plantilla de recordatorio aprobada (opcional, sin esto cae a texto libre)
REMINDER_TEMPLATE_NAME=

# Airtable
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# LLM — REQUERIDO. Cualquier proveedor con API estilo OpenAI (/chat/completions).
# DEFAULT: Groq + openai/gpt-oss-20b. Key: https://console.groq.com
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_MS=25000
#
# ⚠️ PRODUCCIÓN: el free tier de Groq son 8.000 tokens/min. Un bot con herramientas
# lo topa con ~2 clientes a la vez → el bot espera ~20s y responde (no se cae, pero
# es lento bajo ráfaga). Para el cliente que paga: activar Dev tier (pay-as-you-go)
# en https://console.groq.com/settings/billing — gpt-oss-20b ≈ $9/mes para un taller.
# Con Dev tier el tope de 8k desaparece.
#
# NO usar Google Gemini con herramientas: 2.5 y 3.x exigen thought_signature y el
# modo compatible-OpenAI lo rompe (error 400 al usar cualquier tool).
# (Se aceptan también los nombres viejos GROQ_API_KEY/GROQ_MODEL/GROQ_BASE_URL/etc.)

# Resiliencia (todas con default sensato; ver RUNBOOK)
LOCK_TIMEOUT_MS=45000
OWNER_NOTIFY_COOLDOWN_MS=600000
DB_POOL_MAX=10
# Minutos que el bot calla tras detectar intervención humana (o comando #humano)
HUMAN_TIMEOUT_MIN=20
# Detección de "la administradora respondió desde la app de WhatsApp" (coexistence).
# off por defecto; poner "on" solo tras verificar el shape del payload en producción.
COEXISTENCE_ECHO_DETECT=on

# Client Config
SHOP_NAME=
SHOP_CITY=
SHOP_ADDRESS=
SHOP_HOURS=
SHOP_SERVICES=
GOOGLE_REVIEW_URL=

# Availability generator
SHOP_CAPACITY=

# Owner (alertas de emergencia)
OWNER_PHONE=
OWNER_NAME=
EXCLUDED_PHONE=

# Shop Technicians (comma-separated names)
SHOP_TECHNICIANS=

# Dashboard Credentials
DASHBOARD_EMAIL=
DASHBOARD_PASSWORD=

# Server
NODE_ENV=
PORT=3000
